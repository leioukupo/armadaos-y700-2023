**/node_modules
decky/freedom-control/decky/armada-control/dist
# Submodule Git metadata carries absolute host paths; keep it out of the context.
.git
**/.git
# Package sources build in packages/Containerfile with packages/ as their own
# context. The image build consumes only their published images.
packages
# Build artifacts land here. Letting them into the context makes every attempt
# copy a multi-gigabyte .img.gz into the buildah temp dir, which fills the disk.
output
output/*
