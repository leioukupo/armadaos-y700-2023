Justfile.local
output/
_build*
cosign.key
__pycache__/
*.pyc

# Local-only evidence/reports kept out of the tree (narrow, path-anchored)
/local-reports/
/devices/lenovo-tb323fu/docs/evidence/
/devices/lenovo-tb323fu/docs/status-*.md
/devices/lenovo-tb323fu/docs/*-202610*.md
/docs/y700-g9-integration.md

# decky/plugin-sources.json is the source of truth; the resolver generates these
/decky/bundled-plugins/plugins.lock.json
/decky/bundled-plugins/plugins.resolved.json
/decky/bundled-plugins/assets/


# Local-only build scratch (board helper scripts, progress log, editor state)
/.work/
/PROGRESS.md
/.vscode/
/_board.py
/_*.sh
/_*.py
/tmp_*

# Extracted ath11k WCN6855 blobs stay local: the image ships them from the
# atheros-firmware rpm, and these older copies would shadow its board-2.bin.
/system_files/usr/lib/firmware/ath11k/
