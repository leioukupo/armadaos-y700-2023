# Shared PowerDevil defaults for every Armada device and both KDE shells
# (Plasma Desktop and Plasma Mobile). /etc/xdg is read before ~/.config, so an
# explicit user choice in ~/.config/powerdevilrc still wins; no key is marked
# immutable with the [$i] flag.
#
# PowerButtonAction=128 (verified against PowerDevil 6.7.5) is
# ToggleScreenOnOff: a short power press only blanks or restores the display,
# without suspending, freezing apps or muting audio. PowerDownAction, LidAction
# and AutoSuspendAction are deliberately left at their stock values.
[AC][SuspendAndShutdown]
PowerButtonAction=128

[Battery][SuspendAndShutdown]
PowerButtonAction=128

[LowBattery][SuspendAndShutdown]
PowerButtonAction=128

# Screen energy saving is switched off for every plan. On a tablet panel PowerDevil
# is the only thing that idles the display, and on the Y700 Gen 2 that idle blank is
# not recoverable: the DSI link drops, the panel keeps whatever frame it was last
# given and the ktz8866 lamp stays lit, so the tablet looks like it froze on the
# boot logo (PROGRESS.md A172/A144). kscreen refuses to re-enable the only output,
# so the single way back was a compositor restart - which is exactly what made a
# healthy boot look dead for this port.
[AC][DisplayEnergy]
DPMSDisable=true
DisplayTimeout=0

[Battery][DisplayEnergy]
DPMSDisable=true
DisplayTimeout=0

[LowBattery][DisplayEnergy]
DPMSDisable=true
DisplayTimeout=0
