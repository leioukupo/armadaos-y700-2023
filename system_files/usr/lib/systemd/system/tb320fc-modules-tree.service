[Unit]
Description=TB320FC stage the payload kernel module tree (bind from /var + prefer patched modules)
Documentation=file:/usr/libexec/tb320fc/modload
DefaultDependencies=no
After=local-fs-pre.target ostree-remount.service
Before=sysinit.target systemd-modules-load.service tb320fc-audio.service tb320fc-power.service tb320fc-input.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tb320fc/modules-tree

[Install]
WantedBy=sysinit.target
