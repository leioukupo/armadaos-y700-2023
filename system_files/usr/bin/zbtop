#!/bin/sh
set -eu

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/zbtop"

if [ ! -f "$config_dir/btop.conf" ]; then
	mkdir -p "$config_dir"
	cp /usr/share/zbtop/btop.conf "$config_dir/btop.conf"
fi

btop_bin=/usr/libexec/armada/btop-cn
[ -x "$btop_bin" ] || btop_bin=/usr/bin/btop
exec "$btop_bin" --config "$config_dir/btop.conf" "$@"
