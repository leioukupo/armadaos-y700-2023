#!/usr/bin/env python3
"""Arm a one-shot launcher EDL request. Default is a read-only capability check."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import stat
import struct
import subprocess
import sys
import uuid
import zlib

SIZE = 2 * 1024**3
REGION_BYTES = 65536
REGION_OFFSET = SIZE - REGION_BYTES
SLOT_BYTES = 4096

class Refuse(RuntimeError):
    pass

def require(condition, message):
    if not condition:
        raise Refuse(message)

def u32(data, offset):
    return struct.unpack_from('<I', data, offset)[0]

def u64(data, offset):
    return struct.unpack_from('<Q', data, offset)[0]

def parse_store(header, region, partition_uuid, board):
    require(len(header) == REGION_BYTES and len(region) == REGION_BYTES, 'Short settings read')
    meta = json.loads(header.decode('utf-8'))
    part = uuid.UUID(partition_uuid).bytes
    installation = uuid.UUID(meta['installationId']).bytes
    require(meta['kind'] == 'armada-board-recovery-image' and meta['schemaVersion'] == 3,
            'Backup has no provisioned launcher settings region')
    require(meta['imageBytes'] == SIZE and meta['headerBytes'] == REGION_BYTES and
            meta['payloadOffset'] == REGION_BYTES and meta['configRegionOffset'] == REGION_OFFSET and
            meta['configRegionBytes'] == REGION_BYTES and meta['configBoardId'] == board and
            uuid.UUID(meta['configPartitionUuid']).bytes == part,
            'Backup metadata does not match the internal partition')
    require(0 < meta['compressedBytes'] <= REGION_OFFSET - REGION_BYTES, 'Invalid backup payload bounds')
    d = region[:SLOT_BYTES]
    require(d[:8] == b'KSCFGV3\0' and u32(d, 8) == 1 and u32(d, 12) == SLOT_BYTES and
            zlib.crc32(d[:4092]) == u32(d, 4092), 'Invalid settings descriptor')
    require(u64(d, 16) == SIZE and u64(d, 24) == REGION_BYTES + meta['compressedBytes'] and
            u64(d, 32) == REGION_OFFSET and u32(d, 40) == REGION_BYTES and u32(d, 44) == SLOT_BYTES and
            u32(d, 80) == SLOT_BYTES and u32(d, 84) == 2 * SLOT_BYTES and u32(d, 88) == board and
            d[48:64] == part and d[64:80] == installation and any(part) and any(installation) and
            not any(d[92:4092]) and not any(region[3*SLOT_BYTES:]), 'Settings descriptor identity or layout mismatch')
    valid = []
    for index in (0, 1):
        raw = region[(index+1)*SLOT_BYTES:(index+2)*SLOT_BYTES]
        version = u32(raw, 8)
        if version not in (1, 2, 3):
            continue
        reserved = (68, 72, 76)[version-1]
        values = [u32(raw, 56), u32(raw, 60), u32(raw, 64),
                  u32(raw, 68) if version >= 2 else 0, u32(raw, 72) if version == 3 else 0]
        if (raw[:8] == b'KSCFGR1\0' and u32(raw, 12) == SLOT_BYTES and u64(raw, 16) > 0 and
            raw[24:40] == part and raw[40:56] == installation and values[0] <= 2 and
            values[1] <= (3 if version == 1 else 4) and values[2] <= 1 and values[3] <= 3 and
            values[4] <= 1 and not any(raw[reserved:4092]) and zlib.crc32(raw[:4092]) == u32(raw, 4092)):
            valid.append({'index': index, 'sequence': u64(raw, 16), 'values': values, 'raw': raw})
    require(valid, 'No valid saved settings; boot the launcher and save settings first')
    if len(valid) == 2 and valid[0]['sequence'] == valid[1]['sequence']:
        require(valid[0]['raw'] == valid[1]['raw'], 'Conflicting settings generations')
    best = max(valid, key=lambda item: item['sequence'])
    return {'header': header, 'region': region, 'partition_uuid': partition_uuid, 'board': board,
            'partition_bytes': part, 'installation': installation, 'best': best}

def set_request(fd, store, action):
    require(action in (0, 1), 'Unknown request')
    require(os.pread(fd, REGION_BYTES, 0) == store['header'] and
            os.pread(fd, REGION_BYTES, REGION_OFFSET) == store['region'],
            'Settings changed since they were read')
    best = store['best']
    if best['values'][4] == action:
        return best['sequence']
    require(best['sequence'] < 2**64-1, 'Settings sequence exhausted')
    sequence = best['sequence'] + 1
    raw = bytearray(SLOT_BYTES)
    raw[:8] = b'KSCFGR1\0'
    struct.pack_into('<IIQ', raw, 8, 3, SLOT_BYTES, sequence)
    raw[24:40] = store['partition_bytes']
    raw[40:56] = store['installation']
    struct.pack_into('<5I', raw, 56, *best['values'][:4], action)
    struct.pack_into('<I', raw, 4092, zlib.crc32(raw[:4092]))
    offset = REGION_OFFSET + (2-best['index']) * SLOT_BYTES
    require(os.pwrite(fd, raw, offset) == SLOT_BYTES, 'Incomplete settings write; not rebooting')
    os.fsync(fd)
    require(os.pread(fd, SLOT_BYTES, offset) == raw, 'Settings readback failed; not rebooting')
    return sequence

def device_context():
    dt = Path('/proc/device-tree')
    compatible = (dt/'compatible').read_bytes().split(b'\0')
    profiles = [(b'lenovo,elden', b'qcom,sm8750', 1), (b'lenovo,baldur', b'qcom,sm8850', 2)]
    matches = [board for name, soc, board in profiles if name in compatible and soc in compatible]
    require(len(matches) == 1, 'Unsupported board')
    board = matches[0]
    chosen = dt/'chosen'
    require((chosen/'kshim,edl-request-version').read_bytes() == struct.pack('>I', 1),
            'Installed launcher does not support Linux EDL requests')
    report = (chosen/'kshim,settings-v1').read_bytes()
    require(len(report) == 64, 'Missing native settings report')
    v = struct.unpack('>16I', report)
    require(v[0] == 1 and v[1] == board and v[2] == 0 and v[3] == 0 and v[4] == 0 and
            v[5] == 1 and v[12] == 0 and v[13] == 1, 'Launcher has not verified usable internal settings')
    result = subprocess.run(['blkid', '-t', 'PARTLABEL=ARMADA_BACKUP', '-o', 'device'],
                            capture_output=True, text=True, check=True)
    candidates = []
    for name in result.stdout.splitlines():
        dev = Path(name).resolve()
        info = dev.stat()
        require(stat.S_ISBLK(info.st_mode), 'Backup path is not a block device')
        node = Path('/sys/dev/block/%d:%d' % (os.major(info.st_rdev), os.minor(info.st_rdev))).resolve()
        if not any(part.endswith('.ufs') for part in node.parts):
            continue
        require((node/'partition').is_file() and int((node/'size').read_text())*512 == SIZE,
                'Internal backup partition is not exactly2GiB')
        block = int((node.parent/'queue/logical_block_size').read_text())
        require(block in (512, 4096), 'Unsupported logical block size')
        part_uuid = subprocess.check_output(['blkid', '-s', 'PARTUUID', '-o', 'value', str(dev)], text=True).strip()
        candidates.append((dev, part_uuid, board, info.st_rdev))
    require(len(candidates) == 1, 'Expected one internal UFS ARMADA_BACKUP partition')
    return candidates[0]

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='Check support without writing (default)')
    mode.add_argument('--reboot', action='store_true', help='Arm one-shot EDL and reboot normally')
    mode.add_argument('--cancel', action='store_true', help='Cancel an armed request without rebooting')
    args = parser.parse_args(argv)
    dev, part_uuid, board, device_number = device_context()
    writing = args.reboot or args.cancel
    fd = os.open(dev, (os.O_RDWR if writing else os.O_RDONLY) | os.O_CLOEXEC)
    try:
        require(os.fstat(fd).st_rdev == device_number, 'Backup device changed')
        fcntl.flock(fd, (fcntl.LOCK_EX if writing else fcntl.LOCK_SH) | fcntl.LOCK_NB)
        store = parse_store(os.pread(fd, REGION_BYTES, 0), os.pread(fd, REGION_BYTES, REGION_OFFSET), part_uuid, board)
        if not writing:
            print(json.dumps({'ready': True, 'board': board, 'partition': str(dev),
                              'sequence': store['best']['sequence'], 'pending_edl': bool(store['best']['values'][4])}))
            return 0
        if args.cancel:
            sequence = set_request(fd, store, 0)
            print(json.dumps({'cancelled': True, 'sequence': sequence}))
            return 0
        require(store['best']['values'][4] == 0, 'An EDL request is already armed')
        sequence = set_request(fd, store, 1)
        print(json.dumps({'armed_edl': True, 'sequence': sequence}), flush=True)
        result = subprocess.run(['systemctl', 'reboot'], check=False)
        if result.returncode:
            current = parse_store(os.pread(fd, REGION_BYTES, 0), os.pread(fd, REGION_BYTES, REGION_OFFSET), part_uuid, board)
            set_request(fd, current, 0)
            raise Refuse('System reboot failed; the EDL request was cancelled')
        return 0
    finally:
        os.close(fd)

if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (Refuse, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print('armada-reboot-edl: '+str(error), file=sys.stderr)
        raise SystemExit(1)
