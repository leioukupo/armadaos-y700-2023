#!/usr/bin/python3
"""Pin Steam's idle backlight dim on panels that cannot show it.

Steam dims the backlight after IdleBacklightDim{Battery,AC}Seconds without input, and
the dim lands at ~3 % of the backlight range. On the Legion Y700 Gen2 that is 61/2047
on the ktz8866 lamp, under the panel's visible threshold: after fifteen idle minutes
the tablet reads as switched off with only the performance overlay still lit on top of
it. The gaming session runs this before Steam reads its config, so a device profile
can hold the timers (0 = never dim).
"""

import os
import re
import sys
from pathlib import Path

KEYS = ("IdleBacklightDimBatterySeconds", "IdleBacklightDimACSeconds")
CONFIG_PARTS = ("Steam", "config", "config.vdf")


def config_path():
    override = os.environ.get("ARMADA_STEAM_CONFIG_VDF")
    if override:
        return Path(override)
    data_home = os.environ.get("XDG_DATA_HOME")
    base = Path(data_home) if data_home else Path.home() / ".local" / "share"
    return base.joinpath(*CONFIG_PARTS)


def value_pattern(key):
    # Steam writes one entry per line: indent "key" indent "value".
    return re.compile(r'^(\s*")' + re.escape(key) + r'("\s+")([^"]*)("\s*)$')


def insert_keys(lines, keys, seconds):
    """Add the keys to the shallowest System block, which is Steam's local section."""
    # Brace depth only counts the standalone brace lines Steam writes; quoted values
    # may hold braces and stay invisible to this scan.
    depth = 0
    section = None
    for index, line in enumerate(lines):
        text = line.strip()
        if text == "{":
            depth += 1
        elif text == "}":
            depth -= 1
        elif text == '"System"':
            if section is None or depth < section[0]:
                section = (depth, index)
    if section is None:
        return False
    for brace in range(section[1] + 1, len(lines)):
        if lines[brace].strip() == "":
            continue
        if lines[brace].strip() != "{":
            break
        indent = "\t\t"
        header = lines[section[1]]
        lead = header[: len(header) - len(header.lstrip())]
        if header.strip():
            indent = lead + "\t"
        lines[brace + 1 : brace + 1] = [f'{indent}"{key}"\t\t"{seconds}"\n' for key in keys]
        return True
    return False


def main():
    seconds = os.environ.get("ARMADA_STEAM_IDLE_DIM_SECONDS", "")
    if seconds == "":
        # No device policy: leave Steam's own setting alone.
        return 0
    if not seconds.isdigit():
        print(f"armada-steam-idle-dim: bad second count {seconds!r}", file=sys.stderr)
        return 2

    path = config_path()
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        # Steam has not written a config yet; the next session start pins it.
        return 0

    lines = text.splitlines(keepends=True)
    patterns = {key: value_pattern(key) for key in KEYS}
    found = set()
    changed = False
    for index, line in enumerate(lines):
        for key, pattern in patterns.items():
            match = pattern.match(line)
            if not match:
                continue
            found.add(key)
            if match.group(3) == seconds:
                continue
            lines[index] = f"{match.group(1)}{key}{match.group(2)}{seconds}{match.group(4)}"
            changed = True

    missing = [key for key in KEYS if key not in found]
    if missing:
        if insert_keys(lines, missing, seconds):
            changed = True
        else:
            print(f"armada-steam-idle-dim: no System section in {path}", file=sys.stderr)
            return 1

    if not changed:
        return 0

    # Steam rewrites this file when a setting changes, so replace it in one step.
    temp = path.with_name(f"{path.name}.armada-tmp")
    try:
        temp.write_text("".join(lines), encoding="utf-8")
        os.chmod(temp, path.stat().st_mode & 0o7777)
        os.replace(temp, path)
    except OSError as error:
        temp.unlink(missing_ok=True)
        print(f"armada-steam-idle-dim: cannot write {path}: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
