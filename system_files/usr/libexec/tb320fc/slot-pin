#!/bin/sh
# SPDX-License-Identifier: MIT
# TB320FC: put the Android A/B boot-slot flags back the way the vendor leaves them.
#
# Why this runs on every boot (PROGRESS.md A194).  This bootloader keeps the slot
# decision in the GPT partition-entry attributes of the UFS LU that carries
# boot_a/boot_b, and it expects the OS to mark the slot it booted as a verified,
# successful boot.  ArmadaOS is a payload Linux: nothing in it sends that report,
# so XBL keeps treating whichever slot it loaded as untried.  The slot loses
# priority, gains dont-boot-again, the boot menu alternates between the two
# slots' kshimc (once you see the Android-slot menu, once you see the ArmadaOS
# one), and when both sides run out of priority the board just sits on the
# fastboot screen.  Measured on HA1WZJJ5: boot sat at prio 7/2 with boot-failed
# set on both sides while the 26 firmware pairs sat at the vendor resting state
# 15/11 with dont-boot-again on the inactive side.
#
# The payload cannot stop XBL from decrementing, but re-writing the vendor resting
# state after a boot that reached multi-user.target makes the decay harmless, and
# raising dont-boot-again on the other side keeps the menu on one slot.  Both
# jobs are done by `slot-attrs pin`, which is idempotent and refuses to write
# anything it cannot prove is consistent.
#
# The running kernel cannot say which slot it came from - the payload cmdline has
# no androidboot.slot_suffix and the DT chosen node has no bootloader property -
# so the slot is declared below.  slot=b is where this board keeps the ArmadaOS
# boot image.
#
# Kill switch: pin=off in /etc/tb320fc/slot-pin.conf
TB320FC_TAG=TB320FC-SLOT-PIN-v1
CONF=${TB320FC_SLOT_PIN_CONF:-/etc/tb320fc/slot-pin.conf}
pin=on
slot=b
pairs=boot
prio=
peer_prio=
commit=on
if [ -f "${CONF}" ] ; then
	TMPC=$(mktemp 2>/dev/null || echo /tmp/tb320fc-slot-pin.conf.$$)
	tr -d '\r' < "${CONF}" > "${TMPC}" 2>/dev/null && . "${TMPC}" 2>/dev/null
	rm -f "${TMPC}"
fi

if [ "${pin}" != on ] ; then
	echo "${TB320FC_TAG} skip pin=${pin}"
	exit 0
fi
sh "$(dirname "$0")/board-check" || { echo "${TB320FC_TAG} skip board-mismatch" ; exit 0 ; }
case ${slot} in
	a|b) ;;
	*) echo "${TB320FC_TAG} FAIL slot=${slot} wants a or b" >&2 ; exit 1 ;;
esac

# slot-attrs locates the LU through the by-partlabel link, so the link has to be
# there.  UFS is cold at this point in a payload boot, so give udev a chance
# instead of letting the first boot after a flash look like a broken service.
# TB320FC_SLOT_DEV overrides the hunt (it is also what lets the test suite drive
# this script against a GPT image file).
dev=${TB320FC_SLOT_DEV:-}
pass_disk=0
if [ -n "${dev}" ] ; then
	pass_disk=1
else
	i=0
	while [ "${i}" -lt 30 ] ; do
		for cand in /dev/disk/by-partlabel/boot_a /dev/block/by-name/boot_a ; do
			if [ -e "${cand}" ] ; then
				dev=${cand}
				break
			fi
		done
		if [ -n "${dev}" ] ; then break ; fi
		i=$((i + 1))
		if [ "${i}" -lt 30 ] ; then sleep 1 ; fi
	done
fi
if [ -z "${dev}" ] ; then
	echo "${TB320FC_TAG} skip no-boot_a-partlabel-after-30s"
	exit 0
fi

SA=
for d in "$(dirname "$0")" /usr/libexec/tb320fc /usr/local/libexec/tb320fc ; do
	if [ -x "${d}/slot-attrs" ] ; then
		SA=${d}/slot-attrs
		break
	fi
done
if [ -z "${SA}" ] ; then
	echo "${TB320FC_TAG} FAIL helper-missing helper=slot-attrs" >&2
	exit 1
fi

set -- pin --slot "${slot}"
if [ "${pass_disk}" = 1 ] ; then set -- "$@" --disk "${dev}" ; fi
OLDIFS=${IFS}
IFS=,
for p in ${pairs} ; do
	if [ -n "${p}" ] ; then set -- "$@" --pair "${p}" ; fi
done
IFS=${OLDIFS}
if [ -n "${prio}" ] ; then set -- "$@" --prio "${prio}" ; fi
if [ -n "${peer_prio}" ] ; then set -- "$@" --peer-prio "${peer_prio}" ; fi
if [ "${commit}" = on ] ; then set -- "$@" --commit ; fi

echo "${TB320FC_TAG} start slot=${slot} pairs=${pairs} commit=${commit}"
sh "${SA}" "$@"
rc=$?
echo "${TB320FC_TAG} done rc=${rc}"
exit ${rc}
