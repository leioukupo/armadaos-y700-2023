+/*
+ * Lenovo Y700 Gen 2 (TB320FC): the speakers hang off AudioReach -> PRIMARY_MI2S ->
+ * two CS35L45. UCM powers the amplifiers up when the ALSA device is opened, before
+ * the ADSP graph has been started, so the ASP RX never gets a TDM frame to lock to.
+ * The path then reads perfectly healthy - AMP on, DSP1 running, PRI_MI2S clock at
+ * 1536000, pcm0p RUNNING with hw_ptr advancing in real time - and nothing comes out.
+ * Only running the power sequence again while a stream is actually running recovers
+ * it, so do it here, in process context, right after the backend has started.
+ */
+static int relock_delay_ms = 100;
+module_param(relock_delay_ms, int, 0644);
+MODULE_PARM_DESC(relock_delay_ms, "ms after a stream starts before the amplifiers are re-locked, 0 disables");
+
+static int relock_gap_ms = 200;
+module_param(relock_gap_ms, int, 0644);
+MODULE_PARM_DESC(relock_gap_ms, "ms the amplifiers stay powered down inside a re-lock");
+
+static void cs35l45_relock_amps(struct work_struct *work)
+{
+	struct cs35l45_private *cs35l45 = container_of(to_delayed_work(work),
+						       struct cs35l45_private,
+						       relock_work);
+	int ret;
+
+	if (!cs35l45->dsp.cs_dsp.running)
+		return;
+
+	dev_info(cs35l45->dev, "re-locking amplifiers after stream start\n");
+
+	ret = pm_runtime_get_sync(cs35l45->dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(cs35l45->dev);
+		dev_err(cs35l45->dev, "re-lock failed to resume the device: %d\n", ret);
+		return;
+	}
+
+	cs35l45_set_cspl_mbox_cmd(cs35l45, cs35l45->regmap, CSPL_MBOX_CMD_PAUSE);
+	msleep(relock_gap_ms);
+	regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES, 0);
+	msleep(5);
+	regmap_write(cs35l45->regmap, CS35L45_GLOBAL_ENABLES, CS35L45_GLOBAL_EN_MASK);
+	usleep_range(CS35L45_POST_GLOBAL_EN_US, CS35L45_POST_GLOBAL_EN_US + 100);
+	ret = cs35l45_set_cspl_mbox_cmd(cs35l45, cs35l45->regmap, CSPL_MBOX_CMD_RESUME);
+	if (ret)
+		dev_err(cs35l45->dev, "re-lock failed to resume CSPL: %d\n", ret);
+
+	pm_runtime_put_autosuspend(cs35l45->dev);
+}
