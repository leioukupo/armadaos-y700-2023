+static int cs35l45_asp_dai_trigger(struct snd_pcm_substream *substream, int cmd,
+				   struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *component = dai->component;
+	struct cs35l45_private *cs35l45 = snd_soc_component_get_drvdata(component);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (relock_delay_ms > 0)
+			schedule_delayed_work(&cs35l45->relock_work,
+					      msecs_to_jiffies(relock_delay_ms));
+		break;
+	default:
+		break;
+	}
+
+	return 0;
+}
