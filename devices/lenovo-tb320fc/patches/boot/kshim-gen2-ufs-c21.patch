+/* ------------------------------------------------------------------------ */
+/* Bounded read-only Qualcomm A/B GPT scan.
+ *
+ * This is the observation half of the slot work: it opens each LUN the
+ * controller reports, reads only the GPT header block and its entry array,
+ * verifies both CRCs the way ABL does, and records the boot_a / boot_b
+ * partition attributes. It never opens a LUN for writing, never issues a
+ * WRITE, SYNC or UNMAP, and never touches a controller register outside the
+ * shared claim/release path. The whole scan fits a fixed 16 KiB entry buffer:
+ * a TB320FC LUN declares 96 entries (12 KiB), so the cap also proves the
+ * entry array cannot overflow into the header block.
+ */
+#define AB_HEADER_LBA 1ULL
+#define AB_BLOCK 4096u
+#define AB_MAX_ENTRIES 256u
+static uint8_t AbEntries[KSHIM_UFS_AB_ENTRY_BLOCKS * AB_BLOCK];
+static uint8_t AbHeader[AB_BLOCK];
+
+static uint32_t ab_le32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 |
+           (uint32_t)p[3] << 24;
+}
+
+static uint64_t ab_le64(const uint8_t *p)
+{
+    return (uint64_t)ab_le32(p) | (uint64_t)ab_le32(p + 4) << 32;
+}
+
+/* UTF-16LE partition name compared against a short ASCII literal. */
+static int ab_name_is(const uint8_t *entry, const char *ascii)
+{
+    const uint8_t *n = entry + 56;
+    unsigned i;
+
+    for (i = 0; ascii[i]; ++i)
+        if (n[2 * i] != (uint8_t)ascii[i] || n[2 * i + 1] != 0U)
+            return 0;
+    return n[2 * i] == 0U && n[2 * i + 1] == 0U;
+}
+
+static int ab_header_ok(const uint8_t *block, uint32_t *nent, uint64_t *ent_lba,
+                        uint32_t *ent_crc)
+{
+    uint8_t head[92];
+    uint32_t stored;
+
+    if (memcmp(block, "EFI PART", 8) != 0)
+        return 0;
+    if (ab_le32(block + 8) != 0x10000U || ab_le32(block + 12) != 92U ||
+        ab_le32(block + 20) != 0U)
+        return 0;
+    if (ab_le32(block + 84) != 128U)
+        return 0;
+    *nent = ab_le32(block + 80);
+    if (*nent == 0U || *nent > AB_MAX_ENTRIES)
+        return 0;
+    *ent_lba = ab_le64(block + 72);
+    *ent_crc = ab_le32(block + 88);
+    memcpy(head, block, 92);
+    memset(head + 16, 0, 4);
+    stored = ab_le32(block + 16);
+    return kshim_crc32(head, 92) == stored;
+}
+
+/* One LUN, one GPT header block, at most KSHIM_UFS_AB_ENTRY_BLOCKS of entry
+ * array. Returns nonzero when this LUN carries the boot_a / boot_b pair. */
+static int ab_scan_lun(struct kshim_ufs_host *host, uint8_t number,
+                       struct kshim_ufs_read_report *report)
+{
+    struct kshim_ufs_lun lun;
+    uint32_t nent = 0U, ent_crc = 0U, array_blocks, used;
+    uint64_t ent_lba = 0U, attrs_a = 0U, attrs_b = 0U;
+    int found_a = 0, found_b = 0, i;
+
+    if (kshim_ufs_open_lun(host, number, false, &lun))
+        return 0;
+    report->ab_seen |= 1U << 0;
+    if (lun.block.block_size != AB_BLOCK)
+        return 0;
+    if (kshim_block_read(&lun.block, AB_HEADER_LBA, 1, AbHeader))
+        return 0;
+    if (!ab_header_ok(AbHeader, &nent, &ent_lba, &ent_crc))
+        return 0;
+    report->ab_seen |= 1U << 1;
+    array_blocks = (nent * 128U + AB_BLOCK - 1U) / AB_BLOCK;
+    if (array_blocks > KSHIM_UFS_AB_ENTRY_BLOCKS)
+        return 0;
+    if (ent_lba + array_blocks > lun.block.block_count)
+        return 0;
+    if (kshim_block_read(&lun.block, ent_lba, array_blocks, AbEntries))
+        return 0;
+    used = nent * 128U;
+    if (kshim_crc32(AbEntries, used) != ent_crc)
+        return 0;
+    report->ab_seen |= 1U << 2;
+    for (i = 0; (uint32_t)i < nent; ++i) {
+        const uint8_t *e = AbEntries + (uint32_t)i * 128U;
+        if (ab_name_is(e, "boot_a")) {
+            attrs_a = ab_le64(e + 48);
+            found_a = 1;
+            report->ab_seen |= 1U << 3;
+        } else if (ab_name_is(e, "boot_b")) {
+            attrs_b = ab_le64(e + 48);
+            found_b = 1;
+            report->ab_seen |= 1U << 4;
+        }
+    }
+    if (!found_a || !found_b)
+        return 0;
+    report->ab_seen |= 1U << 5;
+    report->ab_lun = number;
+    report->ab_nent = nent;
+    report->ab_ent_lba = ent_lba;
+    report->ab_block_size = lun.block.block_size;
+    report->ab_block_count = lun.block.block_count;
+    report->ab_attrs_a = attrs_a;
+    report->ab_attrs_b = attrs_b;
+    return 1;
+}
+
+bool kshim_ufs_ab_scan_probe(struct kshim_ufs_host *host,
+                             const struct kshim_ufs_ops *ops, void *arena,
+                             uint64_t physical, void *scratch,
+                             size_t scratch_bytes,
+                             struct kshim_ufs_read_report *report)
+{
+    if (!report)
+        return false;
+    report_reset(report);
+    if (!host || !ops || !arena || !physical || !scratch ||
+        scratch_bytes < KSHIM_UFS_DMA_BYTES) {
+        report->status = KSHIM_STORAGE_ARG;
+        return false;
+    }
+    report->dma_base = physical;
+    report->ab_lun = KSHIM_UFS_AB_LUN_NONE;
+    report->stage = KSHIM_UFS_READ_STAGE_CLAIM;
+    if (host->owned) {
+        report->status = KSHIM_UFS_BUSY;
+        return false;
+    }
+    int rc = kshim_ufs_claim(host, ops, arena, KSHIM_UFS_DMA_BYTES, physical);
+    if (rc && !host->owned) {
+        report->status = rc;
+        report->release_status = KSHIM_STORAGE_OK;
+        report->restore_verified = 1;
+        report->handoff_safe = 1;
+        return true;
+    }
+    if (!rc) {
+        report->stage = KSHIM_UFS_READ_STAGE_NOP;
+        rc = kshim_ufs_nop(host);
+    }
+    if (!rc) {
+#if defined(CONFIG_KSHIM_UFS_DEVICE_WAKE) && CONFIG_KSHIM_UFS_DEVICE_WAKE
+        report->stage = KSHIM_UFS_READ_STAGE_DEVICE;
+        rc = kshim_ufs_prepare_device(host);
+#endif
+    }
+    if (!rc) {
+        report->stage = KSHIM_UFS_READ_STAGE_AB;
+        for (uint8_t number = 0U; number < KSHIM_UFS_AB_MAX_LUNS; ++number) {
+            if (ab_scan_lun(host, number, report))
+                break;
+            /* A refused LUN is normal: unimplemented LUNs answer the INQUIRY
+             * with a check condition, which open_lun reports as an error. */
+            if (host->poisoned) {
+                rc = KSHIM_STORAGE_IO;
+                break;
+            }
+        }
+        rc = 0;
+    }
+    report->stage = KSHIM_UFS_READ_STAGE_DONE;
+    if (!rc)
+        rc = KSHIM_STORAGE_OK;
+    report->status = rc;
+    report_capture(host, report);
+    int release = kshim_ufs_release(host);
+    report->link_after_release = host->link;
+    report->power_after_release = host->power;
+    report->scsi_after_release = scsi_snapshot(host);
+    report->release_status = release;
+    if (release) {
+        report->restore_verified = 0;
+        report->handoff_safe = 0;
+        return false;
+    }
+    if (restore_check(host)) {
+        report->release_status = KSHIM_STORAGE_IO;
+        report->restore_verified = 0;
+        report->handoff_safe = 0;
+        return false;
+    }
+    report->restore_verified = 1;
+    report->handoff_safe = 1;
+    return true;
+}
