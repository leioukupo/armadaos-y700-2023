+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <config.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <kshim_mmu.h>
+#include <kshim_ramlog.h>
+
+#if defined(CONFIG_KSHIM_RAMLOG) && CONFIG_KSHIM_RAMLOG
+
+#define Y7L_TOTAL 0x00100000U
+#define Y7L_HDR   0x00001000U
+#define Y7L_DATA  (Y7L_TOTAL - Y7L_HDR)
+#define Y7L_MAGIC 0x59374c32U /* "Y7L2", the layout the kernel driver expects */
+
+struct y7l_header {
+    uint32_t magic, boot, head, spare;
+};
+
+#define Y7L_PREV_MAX 400U
+#define Y7L_PREV_LINE 58U /* y700_ramlog.c truncates each line at 60 */
+
+static volatile struct y7l_header *Header;
+static uint8_t *Data;
+static char PrevTail[Y7L_PREV_MAX + 1];
+static uint32_t PrevBoot, PrevHead;
+static bool PrevValid;
+static void capture_previous(void);
+static uint32_t Head;      /* bytes written by this boot, wraps over Data */
+static uint32_t Boot;
+static bool Ready;
+
+/* The kernel driver replays the first ring it finds valid, in its own array
+ * order: 0x9f500000, then this one, then 0xf0200000.  A previous kernel boot
+ * leaves a valid ring at the first address, which would hide everything this
+ * runtime wrote.  Clearing four bytes there is exactly what that driver does
+ * to every ring at init, so the location is already known to tolerate it. */
+static void suppress_preferred_ring(void)
+{
+#if defined(CONFIG_KSHIM_RAMLOG_FIRST_RING) && CONFIG_KSHIM_RAMLOG_FIRST_RING
+    const uint64_t other = CONFIG_KSHIM_RAMLOG_FIRST_RING;
+
+    volatile uint32_t *magic = (volatile uint32_t *)(uintptr_t)other;
+
+    if (*magic != Y7L_MAGIC)
+        return;
+    *magic = 0U;
+    __asm__ volatile("dc cvac, %0" :: "r"((uint64_t)(uintptr_t)magic)
+                     : "memory");
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+
+static void publish_header(void)
+{
+    if (!Header)
+        return;
+    Header->head = Head;
+    Header->spare = Y7L_MAGIC ^ Boot;
+    Header->magic = Y7L_MAGIC;
+    __asm__ volatile("dc cvac, %0"
+                     :: "r"((uint64_t)(uintptr_t)Header) : "memory");
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+int kshim_ramlog_open(void)
+{
+    const uint64_t base = CONFIG_KSHIM_RAMLOG_ADDRESS;
+    int map = 0;
+
+    if (Ready)
+        return 0;
+    /* The ring is plain DRAM inside a bank the runtime device tree declares,
+     * so translation, when the runtime turned it on, already covers it.  With
+     * the MMU still off the address is identity by definition, and asking the
+     * page tables for a mapping there is refused rather than needed. */
+    if (kshim_mmu_is_enabled())
+        map = kshim_mmu_add_region(base, Y7L_TOTAL, KSHIM_MMU_NORMAL_WB,
+                                   KSHIM_MMU_READ | KSHIM_MMU_WRITE);
+    Header = (volatile struct y7l_header *)(uintptr_t)base;
+    Data = (uint8_t *)(uintptr_t)(base + Y7L_HDR);
+    PrevValid = (Header->magic == Y7L_MAGIC);
+    PrevBoot = PrevValid ? Header->boot : 0U;
+    PrevHead = PrevValid ? Header->head : 0U;
+    Boot = PrevValid ? Header->boot + 1U : 1U;
+    Head = 0U;
+    /* Before this boot writes a single byte: a kernel that dies mirrors
+     * its own console into the ring, and the ring is the only thing that
+     * reaches the next boot.
+     */
+    capture_previous();
+    suppress_preferred_ring();
+    Header->magic = 0U;
+    Header->boot = Boot;
+    Header->head = 0U;
+    Header->spare = Y7L_MAGIC ^ Boot;
+    __asm__ volatile("dc cvac, %0"
+                     :: "r"((uint64_t)(uintptr_t)Header) : "memory");
+    Ready = true;
+    printf("ramlog: boot %u mmu %d map %d\n", Boot, kshim_mmu_is_enabled(),
+           map);
+    return map;
+}
+
+void kshim_ramlog_write(const char *buffer, uint32_t length)
+{
+    if (!Ready || !buffer || !length)
+        return;
+
+    uint32_t off = Head % Y7L_DATA;
+    while (length) {
+        uint32_t chunk = Y7L_DATA - off;
+
+        if (chunk > length)
+            chunk = length;
+        memcpy(Data + off, buffer, chunk);
+        for (uint32_t at = off; at < off + chunk; at += 64U)
+            __asm__ volatile("dc cvac, %0"
+                             :: "r"((uint64_t)(uintptr_t)(Data + at))
+                             : "memory");
+        Head += chunk;
+        length -= chunk;
+        buffer += chunk;
+        off = 0U;
+    }
+    publish_header();
+}
+
+/* The last Y7L_PREV_MAX bytes of the previous boot, newest byte last,
+ * with anything not printable folded to a space, so one captured boot
+ * stays readable as text on the next one. */
+static void capture_previous(void)
+{
+    uint32_t take, endpos, i, out = 0U;
+
+    PrevTail[0] = 0;
+    if (!PrevValid || PrevHead == 0U)
+        return;
+    take = PrevHead;
+    if (take > Y7L_DATA - 1U)
+        take = Y7L_DATA - 1U;
+    if (take > Y7L_PREV_MAX)
+        take = Y7L_PREV_MAX;
+    endpos = PrevHead % Y7L_DATA; /* one past the last stored byte */
+    for (i = 0U; i < take; ++i) {
+        uint32_t at = (endpos + Y7L_DATA - take + i) % Y7L_DATA;
+        unsigned char c = Data[at];
+
+        PrevTail[out++] = (c >= 32U && c < 127U) ? (char)c : ' ';
+    }
+    PrevTail[out] = 0;
+}
+
+/* Oldest first, so the newest - and therefore most interesting - bytes
+ * land in the last replayed lines. */
+void kshim_ramlog_echo_previous(void)
+{
+    uint32_t i, line = 0U;
+
+    if (!Ready)
+        return;
+    if (!PrevValid || PrevHead == 0U) {
+        printf("prev boot %u: nothing carried over\n", PrevBoot);
+        return;
+    }
+    for (i = 0U; i < sizeof(PrevTail) && PrevTail[i];
+         i += Y7L_PREV_LINE, ++line)
+        printf("prev %u %02u %s\n", PrevBoot, line, PrevTail + i);
+}
+
+void kshim_ramlog_flush(void)
+{
+    publish_header();
+}
+
+uint32_t kshim_ramlog_bytes(void)
+{
+    return Head;
+}
+
+#else /* !CONFIG_KSHIM_RAMLOG */
+
+int kshim_ramlog_open(void) { return -1; }
+void kshim_ramlog_write(const char *buffer, uint32_t length)
+{
+    (void)buffer;
+    (void)length;
+}
+void kshim_ramlog_flush(void) {}
+void kshim_ramlog_echo_previous(void) {}
+uint32_t kshim_ramlog_bytes(void) { return 0U; }
+
+#endif
