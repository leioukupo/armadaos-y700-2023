+/* The Gen2 (TB320FC/SM8475) packer patches the base image entry site
+ * itself: word zero becomes a branch to the attached shim and the
+ * original prologue is preserved only in the manifest backup slots.
+ * Classic images keep a branch at word one and are entered at offset
+ * four.  The protocol is chosen from the image contents so a single
+ * runtime serves both layouts; for the Gen2 layout the five backed-up
+ * slots are restored first and the entry is word zero. */
+static bool word_is_branch(uint32_t word)
+{
+    return (word & 0xfc000000u) == 0x14000000u ||
+           (word & 0xfc000000u) == 0x94000000u;
+}
+
+static uint64_t base_image_entry_offset(uint64_t linux_base,
+                                        const MANIFEST *manifest)
+{
+    const uint32_t word0 = *(const uint32_t *)(linux_base);
+    const uint32_t word1 = *(const uint32_t *)(linux_base + 4);
+    const uint32_t backup_word0 =
+        (uint32_t)manifest->header.base_image.instructions;
+    const bool gen2 = word_is_branch(word0) && !word_is_branch(word1) &&
+                      !word_is_branch(backup_word0);
+    if (!gen2)
+        return 4;
+    const uint64_t *backup =
+        (const uint64_t *)&manifest->header.base_image.instructions;
+    for (uint64_t offset = 0; offset <= 0x30; offset += 0x08)
+        *(uint64_t *)(linux_base + offset) = backup[offset / 8];
+    sync_image_cache(linux_base, 0x40);
+    return 0;
+}
