# Gen2 hardware bring-up round 1: the same TB320FC profile with the whole
# native UFS chain off.  Nothing in this profile touches UFS registers, so the
# only variables are the Gen2 entry handoff, the SDE scan-out discovery and the
# PON/SPMI volume keys.  The stock SM8475 device tree says the UFS host sits
# behind apps-smmu@15000000 with stream id 0xe0, not the 0x60 the Gen4/Gen5
# storage probe hardcodes, so the UFS chain stays off until that is resolved.
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
# UI pixels rotate CCW into the native scanout. The TB320FC panel is
# 1600x2560 portrait; the tablet is held landscape like the TB322FC, so the
# menu uses the same 270-degree rotation the Gen4 profile uses.
CONFIG_KSHIM_UI_ROTATION_CCW=270
CONFIG_KSHIM_MENU_ENTRY_DURATION_MS=0
# 20 logical 2560-pixel rows of the rotated landscape UI, within the
# existing 4 MiB runtime slot (2560 * 20 * 4 + 512 LVGL alignment).
CONFIG_KSHIM_LVGL_BUFFER_BYTES=205312
# CONFIG_KSHIM_TOUCH is not set
# c51 onward: the panel IC is novatek,NVT-ts-spi behind spi@990000, so the GENI
# SPI path is the only shape that can reach it. The A slot carries the same touch
# engine as the B slot so the menu is operable by finger from either shim.
CONFIG_KSHIM_TOUCH_NVT_SPI=y
CONFIG_KSHIM_TOUCH_NVT_FW=y
# CONFIG_KSHIM_SMP is not set
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
# CONFIG_KSHIM_DEBUG_CONSOLE is not set
CONFIG_ASSERT_HALT=y
CONFIG_KSHIM_MENU_STYLE_STAR_CHART=y
CONFIG_KSHIM_MENU_LANGUAGE_SWITCH=y
# No settings store on Gen 2 yet: with the session-settings pages on, an
# unresolved persisted default silently cancels the menu countdown
# (platform_select(): settings && !default_ok -> timeout = 0), which leaves the
# panel showing a menu that never boots anything. The manifest default (Android)
# owns the countdown instead.
# CONFIG_KSHIM_MENU_SESSION_SETTINGS is not set

CONFIG_KSHIM_MENU_CHINESE=y
CONFIG_KSHIM_MENU_ENTRY_DETAILS=y
# CONFIG_KSHIM_MENU_BASE_ANDROID is not set
# A-slot build: the base image IS our ArmadaOS, so the menu must not
# describe it as the stock Android; the manifest entry name owns the label.
CONFIG_KSHIM_MENU_POWER_ACTIONS=y
CONFIG_KSHIM_MENU_ADVANCED_ACTIONS=y
CONFIG_KSHIM_QCOM_REBOOT=y
CONFIG_KSHIM_EDL_DISABLE_SDI=y
# CONFIG_KSHIM_BOOT_TIMING is not set

# Measured TB320FC scanout. This firmware DT has no cont_splash_region, so the
# SDE lookup rejects; the loader still leaves a live RGBA frame here.
CONFIG_KSHIM_FB_MEASURED_SPLASH=y
CONFIG_KSHIM_FB_MEASURED_RENDER_ADDRESS=0xB8000000
CONFIG_KSHIM_FB_MEASURED_WIDTH=1600
CONFIG_KSHIM_FB_MEASURED_HEIGHT=2560
CONFIG_KSHIM_FB_MEASURED_STRIDE=6400
# UI scratch from the same display reservation: past the 0xfa0000 frame, below
# the stack the handoff uses at splash+0x2800000.
CONFIG_KSHIM_UI_SCRATCH_BASE=0xB9000000
CONFIG_KSHIM_UI_SCRATCH_SIZE=0x400000

# No settings store in this profile: nothing is written to storage, and boot
# diagnostics stay off.
# Gen2 entry protocol: the repacker patches the kernel entry prologue itself,
# so the manifest header backup is written back and the base image is entered
# at offset zero instead of the Gen4 offset four.
CONFIG_KSHIM_GEN2_ENTRY_RESTORE=y

# c21: the same Gen2 menu profile with the native UFS chain enabled and the
# read-only A/B GPT scan in place of the Gen4 backup-partition probe. The
# SM8475 UFS stream id (0xe0) is now a per-board fact, so the SMMU identity
# proof and the claim/release path are the remaining unknowns this round
# measures. Nothing here writes the disk.
CONFIG_KSHIM_STORAGE_ENTRY_PROBE=y
CONFIG_KSHIM_UFS_NATIVE_IO=y
CONFIG_KSHIM_UFS_LINK_WAKE=y
CONFIG_KSHIM_UFS_DEVICE_WAKE=y
CONFIG_KSHIM_UFS_READ_PROBE=y
# c49: the title is the user's frame, not a debug readout. The report stays
# in the ramlog ring, which the payload kernel replays into dmesg.
# CONFIG_KSHIM_UFS_TITLE_REPORT is not set
CONFIG_KSHIM_UFS_READ_SCREEN=y
CONFIG_KSHIM_UFS_AB_SCAN=y
CONFIG_KSHIM_UFS_PAYLOAD_PROBE=y
# c25: route A. The other slot's container is copied into a loader-owned DRAM
# window and entered from its own packing contract; nothing is written to disk.
# A181: switched on once (a62) and it does not apply to this slot, so it stays off.
# The staging itself works ("kshim: pay valid 0 step 8 slot 1 base 0xac200000
# blk 13504": slot detection and the 55 MiB read are correct) but pay_find_dtb()
# finds no appended DTB in the staged copy, because Android keeps its dtb in dtbo_b
# and its vendor ramdisk in vendor_boot_b. Re-enabling this only costs a 51 MiB
# read that always fails; see boot/kshim-slots/README.md for the whole finding.
# CONFIG_KSHIM_UFS_PAYLOAD_BOOT is not set
# c25: the runtime console mirror, read back by the payload kernel's
# y700_ramlog driver. This profile has no UART console, so it is the log.
CONFIG_KSHIM_RAMLOG=y
# c38: ring B does not survive a reset on this board, so mirror
# into the firmware-owned camera_region and hide ring B instead.
CONFIG_KSHIM_RAMLOG_ADDRESS=0x9f500000
CONFIG_KSHIM_RAMLOG_FIRST_RING=0xa7000000
