        busybox sync
        gptlog "probe lba=$PROBE saved=$(wc -c < /mnt/gpt/probe-save.bin) want=$(wc -c < /mnt/gpt/probe.bin)"
        dd if=/mnt/gpt/probe.bin of=/dev/sda bs=4096 count=1 seek=$PROBE conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
        busybox sync
        blockdev --flushbufs /dev/sda 2>/dev/null
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
        dd if=/dev/sda bs=4096 count=1 skip=$PROBE of=/tmp/probe.rb 2>/dev/null
