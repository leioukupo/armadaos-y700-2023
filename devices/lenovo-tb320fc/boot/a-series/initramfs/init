    if ! mount -t "$MF" -o rw "$MNT" /mnt 2>/dev/null ; then stage "A56 GPT card rw mount failed" ; return ; fi
    mkdir -p /tmp /mnt/gpt
    GPTG=/mnt/gpt/geom.txt
    GOK=1
    SZS=$(blockdev --getsz /dev/sda 2>/dev/null)
    SZ4=$((SZS / 8))
    LB=$(cat /sys/block/sda/queue/logical_block_size 2>/dev/null)
    RO=$(blockdev --getro /dev/sda 2>/dev/null)
