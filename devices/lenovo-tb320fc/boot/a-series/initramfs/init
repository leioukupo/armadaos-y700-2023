            Z15=$(cat /sys/block/sda/sda15/size 2>/dev/null)
            S16=$(cat /sys/block/sda/sda16/start 2>/dev/null)
            Z16=$(cat /sys/block/sda/sda16/size 2>/dev/null)
            gptlog "sda15 start=$S15 size=$Z15 sda16 start=$S16 size=$Z16"
            gptlog "want  sda15 start=26180928 size=268435456 sda16 start=294616384 size=675529368"
            if [ "$S15" = "26180928" ] && [ "$Z15" = "268435456" ] && [ "$S16" = "294616384" ] && [ "$Z16" = "675529368" ] ; then
                [ -c /dev/sda16 ] || busybox mknod /dev/sda16 b 8 16 2>/dev/null
                gptlog "GPT_SURGERY_OK sda16=$(ls /dev/sda16 2>/dev/null) szs512=$(blockdev --getsz /dev/sda16 2>/dev/null)"
                echo "A56 gpt surgery ok up=$(cat /proc/uptime)" > /mnt/gpt/surgery-done.txt
                busybox sync
            else
                gptlog "GPT_SURGERY_SYSFS_MISMATCH"
            fi
        else
            gptlog "GPT_WRITE_BAD - restoring the saved originals"
            dd if=/mnt/gpt/cur-head.bin of=/dev/sda bs=4096 count=4 seek=0 conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
            dd if=/mnt/gpt/cur-backup.bin of=/dev/sda bs=4096 count=$((BH - BE + 1)) seek=$BE conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
            busybox sync
            busybox partprobe /dev/sda 2>/dev/null
            gptlog "restore attempted, sda15 size now=$(cat /sys/block/sda/sda15/size 2>/dev/null)"
        fi
    else
        gptlog "no surgery this boot: go=$GO ok=$GOK probeok=$PROBEOK"
    fi
    busybox sync
    umount /mnt 2>/dev/null
    busybox sync
    stage "A56 gpt pass done go=$GO ok=$GOK probeok=$PROBEOK"
}
