    gptlog "padding crc pf=$(gpt_crc /tmp/pad.pf) probe=$(gpt_crc /tmp/pad.pr) want=c71c0011"
    [ "$(gpt_crc /tmp/pad.pr)" = "c71c0011" ] || { gptlog "HALT probe target is not empty slack" ; GOK=0 ; }
