        dd if=/mnt/gpt/probe-save.bin of=/dev/sda bs=4096 count=1 seek=$PROBE conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
        busybox sync
        gptlog "probe block restored, probeok=$PROBEOK"
    fi
    if [ "$GO" = "1" ] && [ "$GOK" = "1" ] && [ "$PROBEOK" = "1" ] ; then
        gptlog "WRITING backup-entries@lba$BE backup-header@lba$BH primary-entries@lba$PE primary-header@lba$PH"
        dd if=/mnt/gpt/backup-entries.bin of=/dev/sda bs=4096 count=$EB seek=$BE conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
        dd if=/mnt/gpt/backup-header.bin of=/dev/sda bs=4096 count=1 seek=$BH conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
        dd if=/mnt/gpt/primary-entries.bin of=/dev/sda bs=4096 count=$EB seek=$PE conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
        dd if=/mnt/gpt/primary-header.bin of=/dev/sda bs=4096 count=1 seek=$PH conv=notrunc 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
        busybox sync
        blockdev --flushbufs /dev/sda 2>/dev/null
        busybox sync
        sleep 2
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
        dd if=/dev/sda bs=4096 count=1 skip=$PH of=/tmp/rb.h 2>/dev/null
        dd if=/dev/sda bs=4096 count=$EB skip=$PE of=/tmp/rb.e 2>/dev/null
        dd if=/dev/sda bs=4096 count=$EB skip=$BE of=/tmp/rb.be 2>/dev/null
        dd if=/dev/sda bs=4096 count=1 skip=$BH of=/tmp/rb.bh 2>/dev/null
        ROK=1
        busybox cmp /tmp/rb.h /mnt/gpt/primary-header.bin || { ROK=0 ; gptlog "readback primary-header MISMATCH" ; }
        busybox cmp /tmp/rb.e /mnt/gpt/primary-entries.bin || { ROK=0 ; gptlog "readback primary-entries MISMATCH" ; }
        busybox cmp /tmp/rb.be /mnt/gpt/backup-entries.bin || { ROK=0 ; gptlog "readback backup-entries MISMATCH" ; }
        busybox cmp /tmp/rb.bh /mnt/gpt/backup-header.bin || { ROK=0 ; gptlog "readback backup-header MISMATCH" ; }
        if [ "$ROK" = "1" ] ; then
            gptlog "GPT_WRITE_READBACK_OK"
            busybox partprobe /dev/sda 2>&1 | busybox tail -n 3 >> /mnt/y700-gptlog.txt
            blockdev --rereadpt /dev/sda 2>&1 | busybox tail -n 2 >> /mnt/y700-gptlog.txt
            sleep 1
