    dd if=/dev/sda bs=4096 count=$((BH - BE + 1)) skip=$BE of=/mnt/gpt/cur-backup.bin 2>/dev/null
    busybox sync
    gptlog "saved cur-head.bin=$(wc -c < /mnt/gpt/cur-head.bin) sha8=$(sha256sum /mnt/gpt/cur-head.bin 2>/dev/null | cut -c1-8) cur-backup.bin=$(wc -c < /mnt/gpt/cur-backup.bin) sha8=$(sha256sum /mnt/gpt/cur-backup.bin 2>/dev/null | cut -c1-8) want=$((BH - BE + 1)) blocks"
