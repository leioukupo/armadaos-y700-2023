# A56b CARD MOUNT
stage "A56 start card=$MNT fs=$MF sda=$(ls /dev/sda 2>/dev/null)"
# ---- A56: pick the root.  There are now two real roots: the ext4 the stage-2
# ---- /init put on UFS partition 16 (label y700root-ufs) and the SD card root
# ---- that created it (label y700root).  UFS is tried first.  A candidate is
# ---- only accepted when it mounts, holds an executable /init and a binary from
# ---- it really runs in a chroot - A37 is the lesson that switch_root frees the
# ---- initramfs as its very first step, so an ELF the kernel refuses to execute
# ---- leaves PID 1 dead with no fallback.  Anything less is unmounted and the
# ---- next candidate is tried, which is what keeps a half-finished UFS root
# ---- bootable from the card.  Mount retries stay as in A40: an unclean journal
# ---- after a hard power cut is a real failure mode, so rw, then ro, then
# ---- ro+remount,rw, with the kernel's reason dumped to the card.
try_root() {
    D="$1"
    ATT=0
    MT=0
    while [ $ATT -lt 3 ] ; do
        ATT=$((ATT + 1))
        stage "A56 mount attempt $ATT rw dev=$D"
        if mount -t ext4 -o rw "$D" /mnt/root 2>/dev/null ; then
            MT=1
            break
        fi
        stage "A56 mount $ATT rw dev=$D failed"
        if mount -t ext4 -o ro "$D" /mnt/root 2>/dev/null ; then
            if mount -o remount,rw /mnt/root 2>/dev/null ; then
                MT=1
                stage "A56 remounted rw dev=$D"
            else
                MT=2
                stage "A56 remount rw failed, would switch_root read-only dev=$D"
            fi
            break
        fi
        stage "A56 mount $ATT ro dev=$D failed too"
        stage_dump "A56 dmesg tail after failure $ATT on $D"
        busybox sleep 2
    done
    if [ "$MT" = "0" ] ; then
        stage "A56 ROOT_MOUNT_FAILED dev=$D after $ATT attempts"
        return 1
    fi
    stage "A56 root_mounted mt=$MT dev=$D top=$(ls /mnt/root | busybox tr '\n' ' ')"
    MISS=""
    for v in dev proc sys ; do
        [ -d "/mnt/root/$v" ] || MISS="$MISS $v"
    done
    CREATED="$MISS"
    if [ -n "$MISS" ] && [ "$MT" = "1" ] ; then
        for v in $MISS ; do
            mkdir -p "/mnt/root/$v" 2>/dev/null
        done
        busybox sync
        STILL=""
        for v in dev proc sys ; do
            [ -d "/mnt/root/$v" ] || STILL="$STILL $v"
        done
        if [ -z "$STILL" ] ; then
            MISS=""
            stage "A56 VFS_MOUNTPOINTS_CREATED dev=$D created=$CREATED"
        else
            stage "A56 NO_VFS_MOUNTPOINTS dev=$D still-missing=$STILL - switch_root would fail, next candidate"
        fi
    fi
    if [ -n "$MISS" ] ; then
        stage "A56 NO_VFS_MOUNTPOINTS dev=$D missing=$MISS mt=$MT - switch_root would fail, next candidate"
        umount /mnt/root 2>/dev/null
        return 1
    fi
    INITTGT=""
    for cand in /init /sbin/init /usr/lib/systemd/systemd ; do
        if [ -x "/mnt/root$cand" ] ; then
            INITTGT="$cand"
            break
        fi
    done
    if [ -z "$INITTGT" ] ; then
        stage "A56 NO_ROOT_INIT dev=$D head=$(head -c 40 /mnt/root/init 2>/dev/null | busybox tr '\n' ' ') sbin=$(head -c 40 /mnt/root/sbin/init 2>/dev/null | busybox tr '\n' ' ')"
        umount /mnt/root 2>/dev/null
        return 1
    fi
    stage "A82 root_init=$INITTGT dev=$D osrelease=$(head -c 60 /mnt/root/usr/lib/os-release 2>/dev/null | busybox tr '\n' ' ')"
    if [ -x /mnt/root/bin/busybox ] || [ -x /mnt/root/usr/bin/busybox ] ; then
        chroot /mnt/root /bin/busybox true 2>/dev/null
        T=$?
        stage "A56 chroot_test dev=$D rc=$T"
        if [ "$T" != "0" ] ; then
            stage "A56 CHROOT_TEST_FAILED dev=$D"
            umount /mnt/root 2>/dev/null
            return 1
        fi
    else
        stage "A82 no-busybox-in-root dev=$D - busybox chroot probe skipped"
    fi
    chroot /mnt/root /bin/sh -c 'exit 7' 2>/dev/null
    S=$?
    stage "A56 shell_exec_test dev=$D rc=$S want=7"
    if [ "$S" != "7" ] ; then
        stage "A56 SHELL_EXEC_FAILED dev=$D - /bin/sh is not runnable, next candidate"
        umount /mnt/root 2>/dev/null
        return 1
    fi
    return 0
}
