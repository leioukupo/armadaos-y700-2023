    gptlog "marker go=$GO probe=$PR"
    gpt_chk /mnt/gpt/primary-header.bin c43c21ee || GOK=0
    gpt_chk /mnt/gpt/primary-entries.bin 473edb30 || GOK=0
    gpt_chk /mnt/gpt/backup-entries.bin 473edb30 || GOK=0
    gpt_chk /mnt/gpt/backup-header.bin 3a98e406 || GOK=0
    gpt_chk /mnt/gpt/probe.bin 626a3b9a || GOK=0
    gpt_chk /mnt/gpt/geom.txt d91c5134 || GOK=0
    gpt_chk /mnt/gpt/orig-mbr.bin e53182c7 || GOK=0
    gpt_chk /mnt/gpt/orig-primary-header.bin 04a2cf30 || GOK=0
    gpt_chk /mnt/gpt/orig-primary-entries.bin 54977eae || GOK=0
    gpt_chk /mnt/gpt/orig-backup-entries.bin 54977eae || GOK=0
    gpt_chk /mnt/gpt/orig-backup-header.bin ed321bb4 || GOK=0
    PH=$(gpt_geom p_hdr_lba)
    PE=$(gpt_geom p_ent_lba)
    BE=$(gpt_geom b_ent_lba)
    BH=$(gpt_geom b_hdr_lba)
    EB=$(gpt_geom ent_blocks)
    PF=$(gpt_geom pad_first)
    PL=$(gpt_geom pad_last)
    PROBE=$(gpt_geom probe_lba)
    GTOT=$(gpt_geom lba_total)
    gptlog "geom total=$GTOT p_hdr=$PH p_ent=$PE b_ent=$BE b_hdr=$BH blocks=$EB pad=$PF..$PL probe=$PROBE"
    gpt_num "$PH" && gpt_num "$PE" && gpt_num "$BE" && gpt_num "$BH" && gpt_num "$EB" \
        && gpt_num "$PF" && gpt_num "$PL" && gpt_num "$PROBE" && gpt_num "$GTOT" \
        || { gptlog "HALT geom values are not numeric" ; GOK=0 ; }
    [ "$GTOT" = "$SZ4" ] || { gptlog "HALT geom lba_total != disk size" ; GOK=0 ; }
    [ "$BH" = "$((SZ4 - 1))" ] || { gptlog "HALT backup header is not the last LBA" ; GOK=0 ; }
    [ "$PH" = "1" ] || gptlog "note primary header LBA is $PH"
    [ "$EB" = "1" ] || gptlog "note entry blocks is $EB"
    [ "$PF" = "$((BE + EB))" ] || { gptlog "HALT padding does not start after the backup array" ; GOK=0 ; }
    [ "$PL" = "$((BH - 1))" ] || { gptlog "HALT padding does not end before the backup header" ; GOK=0 ; }
    [ "$PROBE" -ge "$PF" ] && [ "$PROBE" -lt "$BH" ] || { gptlog "HALT probe LBA outside the padding" ; GOK=0 ; }
    [ "$PROBE" != "$BE" ] || { gptlog "HALT probe LBA is the live backup array" ; GOK=0 ; }
    [ "$PE" != "$BE" ] || { gptlog "HALT both entry arrays share one LBA" ; GOK=0 ; }
    dd if=/dev/sda bs=4096 count=1 skip=$PH of=/tmp/hdr.p 2>/dev/null
    dd if=/dev/sda bs=4096 count=1 skip=$BH of=/tmp/hdr.b 2>/dev/null
    dd if=/dev/sda bs=4096 count=$EB skip=$PE of=/tmp/ent.p 2>/dev/null
    dd if=/dev/sda bs=4096 count=$EB skip=$BE of=/tmp/ent.b 2>/dev/null
    SIGP=$(head -c 8 /tmp/hdr.p 2>/dev/null)
    SIGB=$(head -c 8 /tmp/hdr.b 2>/dev/null)
    CRCO=$(gpt_crc /tmp/ent.p)
    CRCB=$(gpt_crc /tmp/ent.b)
    gptlog "sig primary=[$SIGP] backup=[$SIGB] ent.p=$(wc -c < /tmp/ent.p) ent.b=$(wc -c < /tmp/ent.b) crc=$CRCO/$CRCB want=7d154971"
    [ "$SIGP" = "EFI PART" ] || { gptlog "HALT primary signature" ; GOK=0 ; }
    [ "$SIGB" = "EFI PART" ] || { gptlog "HALT backup signature" ; GOK=0 ; }
    [ "$CRCO" = "7d154971" ] || { gptlog "HALT on-disk primary entry crc changed" ; GOK=0 ; }
    [ "$CRCB" = "7d154971" ] || { gptlog "HALT on-disk backup entry crc changed" ; GOK=0 ; }
    busybox cmp /tmp/ent.p /tmp/ent.b || { gptlog "HALT on-disk primary entries != backup entries" ; GOK=0 ; }
    busybox cmp /tmp/ent.p /mnt/gpt/orig-primary-entries.bin || { gptlog "HALT on-disk entries != generator input" ; GOK=0 ; }
    busybox cmp /tmp/hdr.p /mnt/gpt/orig-primary-header.bin || { gptlog "HALT on-disk primary header != generator input" ; GOK=0 ; }
    busybox cmp /tmp/hdr.b /mnt/gpt/orig-backup-header.bin || { gptlog "HALT on-disk backup header != generator input" ; GOK=0 ; }
