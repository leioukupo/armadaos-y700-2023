# TB320FC (Lenovo Legion Y700 Gen2, SM8475) kernel overlay config.
#
# Merged after config/armada-kernel.config.overrides, so these lines win.
# build-kernel.sh only gates =y requests, so every =m here was checked against
# the resolved .config by hand (PROGRESS.md A150).

# Own LOCALVERSION: the kernel release and /usr/lib/modules/<KVER> directory of
# this board build can never be mistaken for the default build's.
CONFIG_LOCALVERSION="-tb320fc"

# --- ADSP + AudioReach speaker chain ---------------------------------------
# The board's speakers are two CS35L45 amps on the ADSP's PRIMARY_MI2S_RX.  All
# of it stays =m on purpose: the core stops retrying deferred probes once
# initcalls are done, so the chain has to be brought up in dependency order
# from user space, after the ADSP is running (usr/libexec/tb320fc/audio).
CONFIG_QCOM_APR=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_QCOM_COMMON=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QDSP6_COMMON=m
CONFIG_SND_SOC_QDSP6_PRM=m
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=m
CONFIG_SND_SOC_QDSP6_CORE=m
CONFIG_SND_SOC_QDSP6_APM=m
CONFIG_SND_SOC_QDSP6_APM_DAI=m
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=m
CONFIG_SND_SOC_WM_ADSP=m
CONFIG_SND_SOC_QCOM_SDW=m
CONFIG_SND_SOC_CS35L45=m
CONFIG_SND_SOC_CS35L45_I2C=m
CONFIG_FW_CS_DSP=m
CONFIG_PINCTRL_SC8280XP_LPASS_LPI=m

# --- power supply / USB-C --------------------------------------------------
# The fuel gauge and both Type-C ports live behind the ADSP PMIC GLINK, so
# battmgr must load after the ADSP, from the real root (=m, loaded by
# usr/libexec/tb320fc/power).  patches/tb320fc-01 derives the charge/energy
# pair and POWER_NOW, which this firmware never answers itself.
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_QCOM_PIL_INFO=m

# --- Wi-Fi -----------------------------------------------------------------
# Built-in ath11k probes inside the initramfs, where /usr/lib/firmware is not
# reachable yet; the failed probe leaves the link down and re-binding PCIe0
# afterwards triggers PCIE_SOC_GLOBAL_RESET, which powers the tablet off
# (PROGRESS.md A120-A130).  Load ath11k from the real root instead.
# ATH11K_PCI selects the PCIe power-sequencer provider, so making the driver a module caps
# PCI_PWRCTRL_PWRSEQ to m as well: the pcie0 host bridge then waits for those
# modules (fw_devlink.strict=1) and the Wi-Fi link comes up when
# usr/libexec/tb320fc/wifi loads them in order.
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_PCI_PWRCTRL_PWRSEQ=m